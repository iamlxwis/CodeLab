<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Python pack has no network, shared storage, or editor-data permission. -->
    <application android:allowBackup="false"
        android:label="CodeLab Python"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <service android:name=".PythonRuntimeService" android:exported="true"
            android:permission="site.lxwis.codelab.permission.BIND_ENGINE"
            android:process=":runtime">
            <meta-data android:name="site.lxwis.codelab.engine.PROTOCOL_VERSION" android:value="1" />
        </service>
    </application>
</manifest>
