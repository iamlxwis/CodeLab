<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Package-local, offline SQL interpreter: no INTERNET, no file access, no backup. -->
    <application android:allowBackup="false" android:label="CodeLab SQLite"
        android:supportsRtl="true" android:theme="@android:style/Theme.Material.NoActionBar">
        <service android:name=".SqlRuntimeService"
            android:exported="true"
            android:permission="site.lxwis.codelab.permission.BIND_ENGINE"
            android:process=":runtime">
            <meta-data android:name="site.lxwis.codelab.engine.PROTOCOL_VERSION" android:value="1"/>
        </service>
    </application>
</manifest>